@model IEnumerable<buoi12.Models.DongHo>

@{
    ViewData["Title"] = "Quản lý đồng hồ";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý đồng hồ</h2>

    <a asp-action="Create" class="btn btn-success">
        Thêm đồng hồ
    </a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="searchString"
               value="@ViewBag.SearchString"
               class="form-control"
               placeholder="Nhập tên đồng hồ hoặc thương hiệu..." />

        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>
    </div>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Mã</th>
            <th>Ảnh</th>
            <th>Tên đồng hồ</th>
            <th>Thương hiệu</th>
            <th>Loại máy</th>
            <th>Giá bán</th>
            <th>Tồn kho</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaDH</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.AnhBia))
                    {
                        <img src="~/images/@item.AnhBia"
                             width="70"
                             height="70"
                             style="object-fit: contain;" />
                    }
                    else
                    {
                        <span>Chưa có ảnh</span>
                    }
                </td>

                <td>@item.TenDH</td>
                <td>@item.ThuongHieu?.TenTH</td>
                <td>@item.LoaiMay?.TenLM</td>
                <td>@item.GiaBan.ToString("N0") VNĐ</td>
                <td>@item.SoLuongTon</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.MaDH"
                       class="btn btn-info btn-sm">
                        Chi tiết
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.MaDH"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.MaDH"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
